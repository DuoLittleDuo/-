# 复制为 .env 后修改。SECRET_KEY 请用下面命令生成后填入：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-this-secret-key

# 数据库（默认已指向 backend/data/app.db，可留空使用默认值）
# DATABASE_URL=sqlite:///d:/dachuang/backend/data/app.db

ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# 语义检索
SEMANTIC_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com
MIN_FINAL_SCORE=0.45
SEARCH_RELATIVE_RATIO=0.80
SEMANTIC_WEIGHT=0.75
KEYWORD_WEIGHT=0.25

# 演示账号（部署到公网前必须修改）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123456
SEED_DEMO_USERNAME=demo
SEED_DEMO_PASSWORD=demo123456
